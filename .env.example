# =====================================================================
# ORCA Marine Environment Variables Configuration Template
# All secrets must be populated in .env or Render Environment Variables
# NEVER commit real credentials to version control.
# =====================================================================

# Server Configuration
PORT=8000

# LLM Reasoning & Synthesis (Gemini 3.6-flash / 3.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# ISRO MOSDAC Satellite Telemetry Access
MOSDAC_API_KEY=your_mosdac_api_key_here
MOSDAC_API_URL=https://api.mosdac.gov.in/v1/ocean/waves
MOSDAC_USERNAME=your_mosdac_username_here
MOSDAC_PASSWORD=your_mosdac_password_here

# Copernicus Marine Service (CMEMS SST Verification)
COPERNICUS_MARINE_USERNAME=your_copernicus_marine_username_here
COPERNICUS_MARINE_PASSWORD=your_copernicus_marine_password_here

# Supabase Server Integration (Server-Side Only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Offshore Satellite Communication Gateway Configuration
SATELLITE_GATEWAY_ENABLED=false
SATELLITE_GATEWAY_URL=
SATELLITE_GATEWAY_API_KEY=
SATELLITE_WEBHOOK_SECRET=
SATELLITE_MESSAGE_TIMEOUT=30
SATELLITE_MAX_PAYLOAD_SIZE=4096
SATELLITE_POLL_INTERVAL_SECONDS=60

# SMS Alert Provider & Safety Guard Configuration
SMS_MODE=disabled
ALERT_SMS_MODE=disabled
SMS_ALERTS_ENABLED=true
SMS_TEST_PHONE_NUMBERS=+919876543210
SMS_PROVIDER=twilio
SMS_API_KEY=your_sms_api_key_here
SMS_API_SECRET=your_sms_api_secret_here
TWILIO_FROM_NUMBER=+1234567890
SMS_SENDER_ID=ORCA-ALERT
MSG91_FLOW_ID=
SMS_ENDPOINT_URL=https://api.example.com/sms/send
SMS_MAX_RETRIES=2
